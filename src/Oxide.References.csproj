<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\netfx.props" />
  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyName>Oxide.References</AssemblyName>
    <Authors>Oxide Team and Contributors</Authors>
    <Copyright>(c) 2013-$([System.DateTime]::Now.Year) $(Authors)</Copyright>
    <Description>Dependency references for the Oxide modding framework</Description>
    <RepositoryUrl>https://github.com/OxideMod/Oxide.References</RepositoryUrl>
    <PackageIconUrl>icon.png</PackageIconUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <TargetFrameworks>net48;netstandard2.0;netstandard2.1</TargetFrameworks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>NU1701;NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ILRepack" Version="2.0.18" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="all" />
    <PackageReference Include="WebSocketSharpFork" Version="1.0.4" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
    <PackageReference Include="ZString" Version="2.6.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" PrivateAssets="all" />

    <!-- BCL polyfill excluded from ILRepack merge — must flow as dependencies -->
    <PackageReference Include="System.Memory" Version="4.5.5" />

    <Content Include="Dependencies\net48\*.*" PackagePath="lib\any\net48" />
    <Content Include="Dependencies\netstandard2.0\*.*" PackagePath="lib\any\netstandard2.0" />
    <Content Include="Dependencies\netstandard2.1\*.*" PackagePath="lib\any\netstandard2.1" />
    <Content Include="Dependencies\any\x64\*.*" PackagePath="lib\any\x64" />
    <Content Include="Dependencies\any\x86\*.*" PackagePath="lib\any\x86" />
    <Content Include="Dependencies\any\Mono.*" Exclude="Dependencies\any\Mono.Posix.dll" PackagePath="lib\any" />
    <Content Include="Dependencies\any\System.*" PackagePath="lib\any" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup>
    <ManualMergeAssembly Include="Mono.Posix">
      <SourcePath>Dependencies\any\Mono.Posix.dll</SourcePath>
    </ManualMergeAssembly>
    <ManualMergeAssembly Include="protobuf-net">
      <SourcePath>Dependencies\any\protobuf-net.dll</SourcePath>
    </ManualMergeAssembly>
  </ItemGroup>
  <Target Name="ComputeMergeAssemblies" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <!-- NuGet DLLs eligible for merging: all CopyLocal DLLs except the build tool and polyfills -->
      <NuGetMergeAssemblies Include="@(ReferenceCopyLocalPaths)" Condition="
        '%(Extension)' == '.dll'
        and '%(NuGetPackageId)' != 'ILRepack'
        and '%(NuGetPackageId)' != 'System.Memory'
        and '%(NuGetPackageId)' != 'System.Buffers'
        and '%(NuGetPackageId)' != 'System.Numerics.Vectors'
        and '%(NuGetPackageId)' != 'System.Runtime.CompilerServices.Unsafe'
        and '%(NuGetPackageId)' != 'System.Threading.Tasks.Extensions'
        and '%(NuGetPackageId)' != 'Microsoft.Bcl.AsyncInterfaces'
        and '%(NuGetPackageId)' != 'System.ValueTuple'" />
      <MergeAssemblies Include="$(TargetDir)\Oxide.References.dll" />
      <MergeAssemblies Include="@(NuGetMergeAssemblies)" />
      <MergeAssemblies Include="@(ManualMergeAssembly->'%(SourcePath)')" />
      <!-- Embed [AssemblyMetadata("Oxide.MergedAssembly", "name")] for each merged assembly.
           Oxide.CSharp reads these at runtime to dynamically skip game DLLs whose types
           are already inside Oxide.References. -->
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'%(NuGetMergeAssemblies.Filename)' != ''">
        <_Parameter1>Oxide.MergedAssembly</_Parameter1>
        <_Parameter2>%(NuGetMergeAssemblies.Filename)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'%(ManualMergeAssembly.Identity)' != ''">
        <_Parameter1>Oxide.MergedAssembly</_Parameter1>
        <_Parameter2>%(ManualMergeAssembly.Identity)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <Target Name="AfterBuild">
    <PropertyGroup>
      <OutputAssembly>$(TargetDir)\Oxide.References.dll</OutputAssembly>
      <Merger>$(PkgILRepack)\tools\ILRepack.exe</Merger>
    </PropertyGroup>
    <Message Text="MERGING: @(MergeAssemblies->'%(Filename)') into $(OutputAssembly)" Importance="High" />
    <Exec Command="$(Merger) /lib:$(TargetDir) /out:&quot;$(OutputAssembly)&quot; @(MergeAssemblies->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>
</Project>
